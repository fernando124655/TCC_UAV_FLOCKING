    <simulink>
        <sim_quad value="0"/>  <!-- 0: r, 1: v, 2:vr -->
        <!-- <local_ip value="'192.168.1.155'"/>-->
        <!-- <target_ip value="ones(1,CoFlyers.number)*157"/>-->
        <local_ip value="'192.168.1.155'"/><!--PC-A-->
        <target_ip value="ones(1,CoFlyers.number)*157"/>
        <number_real value="10"/>
    </simulink>

</CoFlyers>
