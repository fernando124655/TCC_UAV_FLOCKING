<launch>
    <!-- No ROS pareado: vazia, semente 2.
         Pontos de nascimento IDENTICOS aos de hifi_vazia_seed2.launch.
         Gerado por build_hifi_launches.m ; nao editar a mao. -->
    <arg name="ipLocal_"  value="192.168.1.157"/>
    <arg name="ipTarget_" value="192.168.1.155"/>

    <!-- UAV0 : x = -3.2003  y = -23.7037 -->
    <group ns="uav0">
        <arg name="ID" value="0"/>
