<launch>
    <!-- No ROS pareado: cilindros, semente 5.
         Pontos de nascimento IDENTICOS aos de hifi_cilindros_seed5.launch.
         Gerado por build_hifi_launches.m ; nao editar a mao. -->
    <arg name="ipLocal_"  value="192.168.1.157"/>
    <arg name="ipTarget_" value="192.168.1.155"/>

    <!-- UAV0 : x = -13.9003  y = 18.5366 -->
    <group ns="uav0">
        <arg name="ID" value="0"/>
