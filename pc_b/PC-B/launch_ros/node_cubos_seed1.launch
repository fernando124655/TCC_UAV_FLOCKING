<launch>
    <!-- No ROS pareado: cubos, semente 1.
         Pontos de nascimento IDENTICOS aos de hifi_cubos_seed1.launch.
         Gerado por build_hifi_launches.m ; nao editar a mao. -->
    <arg name="ipLocal_"  value="192.168.1.157"/>
    <arg name="ipTarget_" value="192.168.1.155"/>

    <!-- UAV0 : x = -4.1489  y = 11.0162 -->
    <group ns="uav0">
        <arg name="ID" value="0"/>
