<launch>
    <!-- No ROS pareado: cilindros, semente 4.
         Pontos de nascimento IDENTICOS aos de hifi_cilindros_seed4.launch.
         Gerado por build_hifi_launches.m ; nao editar a mao. -->
    <arg name="ipLocal_"  value="192.168.1.157"/>
    <arg name="ipTarget_" value="192.168.1.155"/>

    <!-- UAV0 : x = 23.3515  y = 2.3616 -->
    <group ns="uav0">
        <arg name="ID" value="0"/>
