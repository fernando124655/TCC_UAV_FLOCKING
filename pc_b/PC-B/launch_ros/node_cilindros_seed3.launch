<launch>
    <!-- No ROS pareado: cilindros, semente 3.
         Pontos de nascimento IDENTICOS aos de hifi_cilindros_seed3.launch.
         Gerado por build_hifi_launches.m ; nao editar a mao. -->
    <arg name="ipLocal_"  value="192.168.1.157"/>
    <arg name="ipTarget_" value="192.168.1.155"/>

    <!-- UAV0 : x = 2.5399  y = 10.4074 -->
    <group ns="uav0">
